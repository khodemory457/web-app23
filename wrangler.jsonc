{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app23",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "04823f2c-31e4-47ee-b77f-808f0270e516","database_name": "web-app23" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f9fb189b6f24435e8e7b175b625d9742" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
